{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Promin",
  "mainBinaryName": "Promin",
  "version": "3.2.19",
  "identifier": "com.promin.pdf",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx vite --mode desktop",
    "beforeBuildCommand": "npx vite build --mode desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* blob:; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "publisher": "Promin Partner",
    "targets": ["dmg", "app"],
    "icon": ["icons/macos/promin-app-icon.icns", "icons/macos/app-512.png"],
    "resources": ["libs/*.jar", "runtime/jre/**/*"],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "macOS": {
      "dmg": {
        "background": "macos/dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 200,
          "y": 210
        },
        "applicationFolderPosition": {
          "x": 460,
          "y": 210
        }
      },
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": null,
      "providerShortName": null,
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCNDhFNUE5Q0RBQUM5NTQKUldSVXlhck5xZVZJMnh1Sk9taDBXb2swaHlxMXJLcUtLNzg5NVFMVzliUEswRkx0dlR6dTFGTmYK",
      "endpoints": [
        "https://github.com/karolmarol931-coder/promin/releases/latest/download/latest.json"
      ]
    }
  }
}
